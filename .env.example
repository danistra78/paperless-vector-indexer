# Vorlage fuer .env (cp .env.example .env). Die .env enthaelt Schluessel und
# ist per .gitignore ausgeschlossen - nie committen.

# --- Paperless-ngx ---
PAPERLESS_URL=http://paperless:8000
PAPERLESS_TOKEN=

# --- Embedding-Service (OpenAI-kompatibel, Basis-URL ohne /v1/embeddings) ---
# Beispiel EmbeddingGemma 2 ueber llama.cpp (llama-server --embeddings):
EMBEDDING_URL=http://embedding:8080
EMBEDDING_MODEL=embeddinggemma-2
VECTOR_SIZE=768
# EmbeddingGemma 2 erwartet diese Aufgaben-Praefixe. Fuer Modelle ohne
# Praefixe beide Zeilen weglassen (Standard: {text}).
EMBEDDING_QUERY_TEMPLATE=task: search result | query: {text}
EMBEDDING_DOCUMENT_TEMPLATE=title: {title} | text: {text}

# --- Qdrant ---
# Bei Wechsel von Modell oder Dimension eine neue Collection verwenden.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=paperless_embeddinggemma2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Logging ---
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
SEARCH_MODE=vector
# Pflicht: ohne API_KEY startet die API nicht. Erzeugen z. B. mit
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Schluessel fuer POST /index/<id> (Post-Consume-Script). Leer = Endpunkt aus.
INDEX_API_KEY=
